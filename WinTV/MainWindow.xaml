<Window x:Class="WinTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="WinTV" Icon="Assets/wintv.ico" Width="1440" Height="840" MinWidth="320" MinHeight="180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Группы -->
        <DockPanel x:Name="GroupsPanel" Grid.Column="0" Width="210" Background="{StaticResource Panel}">
            <TextBlock DockPanel.Dock="Top" Text="WinTV" FontSize="22" FontWeight="SemiBold" Margin="18,16,0,12"/>
            <Button x:Name="PlaylistButton" DockPanel.Dock="Top" Margin="10,0,10,8" HorizontalContentAlignment="Stretch"
                    ToolTip="Сменить плейлист" Click="PlaylistButton_Click" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                    <TextBlock x:Name="PlaylistName" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="PlaylistMenu"/>
                </Button.ContextMenu>
            </Button>
            <StackPanel DockPanel.Dock="Bottom" Margin="10">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SideMuteBtn" Content="🔊" Padding="4,2" Background="Transparent"
                            Click="MuteBtn_Click" ToolTip="Без звука (M)"/>
                    <Slider x:Name="SideVolumeSlider" Grid.Column="1" VerticalAlignment="Center" Margin="6,0"
                            Minimum="0" Maximum="150" Value="80" IsMoveToPointEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="SideVolumeText" Grid.Column="2" Text="80%" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                </Grid>
                <Button x:Name="UpdateButton" Content="⬆  Доступно обновление" Background="{StaticResource Accent}"
                        HorizontalContentAlignment="Left" Click="Update_Click" Margin="0,0,0,6" Visibility="Collapsed"/>
                <Button Content="⟳  Обновить" HorizontalContentAlignment="Left" Click="Reload_Click" Margin="0,0,0,6"/>
                <Button Content="⚙  Настройки" HorizontalContentAlignment="Left" Click="Settings_Click"/>
            </StackPanel>
            <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Каналы -->
        <DockPanel x:Name="ChannelsPanel" Grid.Column="1" Width="380" Background="{StaticResource Panel2}">
            <Grid DockPanel.Dock="Top" Margin="10,12,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Поиск канала (Ctrl+F)" Foreground="{StaticResource Muted}" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Grid.Column="1" Content="📅" Margin="6,0,0,0" ToolTip="Программа передач (G)" Click="EpgButton_Click"/>
                <Button Grid.Column="2" Content="◀" Margin="6,0,0,0" ToolTip="Скрыть боковую панель (B)" Click="SidebarToggle_Click"/>
            </Grid>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}"
                       Margin="14,6,14,10" TextTrimming="CharacterEllipsis"/>
            <ListBox x:Name="ChannelList"
                     PreviewMouseLeftButtonUp="ChannelList_PreviewMouseLeftButtonUp">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Избранное (добавить / убрать)" Click="FavMenu_Click"/>
                        <MenuItem Header="Программа передач" Click="EpgMenu_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="46" Height="30" CornerRadius="4" Background="#1A1E25">
                                <Image Source="{Binding LogoImage}"
                                       Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="8,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NowTitle}" Foreground="{StaticResource Muted}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,3"
                                           Visibility="{Binding NowTitle, Converter={StaticResource EmptyVis}}"/>
                                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding NowProgress, Mode=OneWay}"
                                             Visibility="{Binding NowTitle, Converter={StaticResource EmptyVis}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⟲" Foreground="{StaticResource Muted}" ToolTip="Есть архив" Margin="0,0,6,0"
                                           Visibility="{Binding HasArchive, Converter={StaticResource BoolVis}}"/>
                                <TextBlock x:Name="Star" Tag="fav" Text="☆" FontSize="15" Foreground="#4A5160"
                                           Cursor="Hand" ToolTip="Избранное" Background="Transparent"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Star" Property="Text" Value="★"/>
                                <Setter TargetName="Star" Property="Foreground" Value="#F5B83D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Видео -->
        <Grid Grid.Column="2" Background="Black">
            <vlc:VideoView x:Name="Video" Background="Black">
                <Grid x:Name="Overlay" Background="#01000000"
                      MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                      MouseMove="Overlay_MouseMove"
                      MouseLeave="Overlay_MouseLeave"
                      MouseWheel="Overlay_MouseWheel">
                    <Grid.ContextMenu>
                        <!-- Пункты собираются при открытии: дорожки зависят от потока -->
                        <ContextMenu x:Name="VideoMenu" Opened="VideoMenu_Opened"/>
                    </Grid.ContextMenu>

                    <!-- Кнопка вызова боковой панели, когда она скрыта в оконном режиме -->
                    <Button x:Name="ShowSidebarBtn" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                            Background="#D8101318" BorderBrush="#232833" BorderThickness="1"
                            Content="☰  Каналы" Padding="10,6" ToolTip="Показать боковую панель (B)"
                            Click="SidebarToggle_Click" Visibility="Collapsed"/>

                    <!-- Список каналов поверх видео в полноэкранном режиме -->
                    <Border x:Name="FsList" HorizontalAlignment="Left" Width="540" Margin="24,24,0,24"
                            Background="#D8101318" CornerRadius="10" Visibility="Collapsed">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                                <TextBlock DockPanel.Dock="Right" Text="← →  группа" Foreground="#8A93A3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FsGroup" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox x:Name="FsChannels" Focusable="False" Margin="0,0,0,10"
                                     PreviewMouseLeftButtonUp="FsChannels_PreviewMouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Foreground="#8A93A3" FontSize="15" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="46" Height="30" CornerRadius="4" Background="#1A1E25">
                                                <Image Source="{Binding LogoImage}"
                                                       Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="10,0,4,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="White" FontSize="15"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding NowTitle}" Foreground="#A8B0BD" TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,3" Visibility="{Binding NowTitle, Converter={StaticResource EmptyVis}}"/>
                                                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding NowProgress, Mode=OneWay}"
                                                             Visibility="{Binding NowTitle, Converter={StaticResource EmptyVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border x:Name="CenterBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#B0000000" CornerRadius="8" Padding="18,10" Visibility="Collapsed">
                        <TextBlock x:Name="CenterText" Foreground="White" FontSize="18"/>
                    </Border>

                    <Border x:Name="VolumeBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"
                            Background="#B0000000" CornerRadius="8" Padding="14,8" Visibility="Collapsed">
                        <TextBlock x:Name="VolumeText" Foreground="White" FontSize="16"/>
                    </Border>

                    <!-- Экранное инфо (OSD) -->
                    <Border x:Name="Osd" VerticalAlignment="Bottom" Margin="24,0,24,68" Padding="20,14"
                            Background="#C8101318" CornerRadius="10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="90" Height="56" CornerRadius="6" Background="#1A1E25" Margin="0,0,16,0" VerticalAlignment="Top">
                                <Image x:Name="OsdLogo" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OsdNumber" Foreground="#8A93A3" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="OsdName" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                                    <Border x:Name="OsdArchive" Background="#C0392B" CornerRadius="4" Padding="6,1"
                                            Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="АРХИВ" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="OsdTitle" Foreground="White" FontSize="15" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="OsdProgress" Style="{StaticResource ThinProgress}" Margin="0,8,0,6"/>
                                <TextBlock x:Name="OsdNext" Foreground="#8A93A3" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                                <TextBlock x:Name="OsdClock" Foreground="White" FontSize="20" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="OsdTime" Foreground="#8A93A3" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Панель управления плеером поверх видео -->
                    <Border x:Name="PlayerControls" VerticalAlignment="Bottom" Margin="16,0,16,14"
                            Background="#E6101318" BorderBrush="#232833" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Visibility="Collapsed"
                            MouseEnter="PlayerControls_MouseEnter" MouseLeave="PlayerControls_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая часть: Боковая панель, Пауза, Звук -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ControlSidebarBtn" Content="☰" Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="Боковая панель (B)" Click="SidebarToggle_Click"/>
                                <Button x:Name="PlayPauseBtn" Content="⏸" Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="Пауза (Пробел)" Click="PlayPauseBtn_Click"/>
                                <Button x:Name="ControlMuteBtn" Content="🔊" Padding="6,4" Margin="0,0,6,0"
                                        ToolTip="Без звука (M)" Click="MuteBtn_Click"/>
                                <Slider x:Name="ControlVolumeSlider" Width="100" VerticalAlignment="Center" Margin="0,0,6,0"
                                        Minimum="0" Maximum="150" Value="80" IsMoveToPointEnabled="True"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                                <TextBlock x:Name="ControlVolumeText" Text="80%" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" FontSize="12" Width="36"/>
                            </StackPanel>

                            <!-- Центр: Текущий канал и передача -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0" ClipToBounds="True">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="ControlChannelText" Foreground="White" FontWeight="SemiBold"
                                               FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ControlProgrammeText" Foreground="{StaticResource Muted}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Правая часть: Закрепить, EPG, Полный экран -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PinBtn" Content="📌" Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="Поверх остальных окон (Ctrl+T)" Click="PinBtn_Click"/>
                                <Button Content="📅" Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="Программа передач (G)" Click="EpgButton_Click"/>
                                <Button x:Name="FullscreenBtn" Content="⛶" Padding="8,4"
                                        ToolTip="Полный экран (F)" Click="FullscreenBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Grid>

        <!-- Программа передач -->
        <DockPanel x:Name="EpgPanel" Grid.Column="3" Width="370" Background="{StaticResource Panel}" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="16,14,10,8">
                <Button DockPanel.Dock="Right" Content="✕" Padding="10,4" Click="EpgClose_Click"/>
                <StackPanel>
                    <TextBlock x:Name="EpgTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EpgSub" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                    Padding="16,10" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedItem.Desc, ElementName=EpgList}" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"/>
                </ScrollViewer>
            </Border>
            <ListBox x:Name="EpgList" MouseDoubleClick="EpgList_MouseDoubleClick"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           Margin="16,12,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Time" Text="{Binding TimeText}" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" Text="⟲" Foreground="{StaticResource Muted}" Margin="6,0,0,0"
                                       ToolTip="Смотреть из архива"
                                       Visibility="{Binding IsArchive, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNow}" Value="True">
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPast}" Value="True"/>
                                    <Condition Binding="{Binding CanPlay}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Title" Property="Foreground" Value="#5C6370"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
