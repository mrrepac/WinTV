<Window x:Class="WinTV.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Icon="Assets/wintv.ico" Width="1180" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="+ Добавить" Padding="10,3" Margin="0,0,6,0" Click="AddPlaylist_Click"/>
                    <Button Content="Сделать активным" Padding="10,3" Margin="0,0,6,0" Click="ActivatePlaylist_Click"/>
                    <Button Content="Удалить" Padding="10,3" Click="RemovePlaylist_Click"/>
                </StackPanel>
                <TextBlock Text="Плейлисты" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Border BorderBrush="#2E3440" BorderThickness="1" CornerRadius="4" Background="#1C2028">
                <ListBox x:Name="PlaylistList" Height="92" DisplayMemberPath="Display"
                         SelectionChanged="PlaylistList_SelectionChanged"/>
            </Border>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Название" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" TextChanged="PlaylistField_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ссылка на плейлист (M3U / M3U8)" Margin="0,0,0,6"/>
                    <TextBox x:Name="PlaylistBox" TextChanged="PlaylistField_TextChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Программа передач для этого плейлиста (XMLTV, можно .gz)" Margin="0,10,0,6"/>
            <TextBox x:Name="EpgBox" TextChanged="PlaylistField_TextChanged"/>
            <TextBlock Text="Оставьте пустым, чтобы брать адрес из плейлиста (url-tvg)" Foreground="{StaticResource Muted}"
                       FontSize="12" Margin="0,4,0,0"/>

            <TextBlock Text="Формат архива" Margin="0,16,0,4"/>
            <RadioButton x:Name="ModeAuto" GroupName="mode" Content="Автоматически (подобрать сам)"/>
            <RadioButton x:Name="ModeFlussonic" GroupName="mode" Content="Flussonic:  …/mono-СТАРТ-ДЛИТЕЛЬНОСТЬ.m3u8"/>
            <RadioButton x:Name="ModeAppend" GroupName="mode" Content="Добавлять параметры:  ?utc=СТАРТ&amp;lutc=СЕЙЧАС"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="User-Agent (необязательно)" Margin="0,0,0,6"/>
                    <TextBox x:Name="UaBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Буфер сети, мс" Margin="0,0,0,6"/>
                    <TextBox x:Name="CacheBox"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="NoHistoryBox" Margin="0,18,0,0"
                      Content="Не сохранять историю (при запуске не открывать последний канал и группу)"/>
            <CheckBox x:Name="AlwaysOnTopBox" Margin="0,8,0,0"
                      Content="Поверх остальных окон (Always on top)"/>

            <DockPanel Margin="0,18,0,6">
                <Button x:Name="UnlockButton" DockPanel.Dock="Right" Content="Ввести PIN" Padding="10,3"
                        Click="Unlock_Click" Visibility="Collapsed"/>
                <TextBlock Text="Скрытые группы активного плейлиста" VerticalAlignment="Center"/>
            </DockPanel>
            <Border BorderBrush="#2E3440" BorderThickness="1" CornerRadius="4" Background="#1C2028">
                <ScrollViewer Height="130" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GroupChecks" Margin="8,4"/>
                </ScrollViewer>
            </Border>
            <Grid x:Name="PinRow" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Новый PIN для показа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <PasswordBox x:Name="PinBox" Grid.Column="1" MaxLength="12"/>
                <CheckBox x:Name="RemovePinBox" Grid.Column="2" Content="Убрать PIN" Margin="12,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="PinHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Показать скрытые группы в главном окне — Ctrl+H. Пустое поле — PIN не меняется."/>
        </StackPanel>

        <!-- Горячие клавиши -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Сбросить всё" Padding="10,4" Click="ResetHotkeys_Click"/>
                <TextBlock Text="Горячие клавиши" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="HotkeyHint" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Щёлкните по ячейке и нажмите сочетание. Esc — отмена, ✕ — очистить. Стрелки в списках, Enter, Esc и цифры (номер канала) работают всегда."/>
            <ScrollViewer MaxHeight="580" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HotkeyRows" Margin="0,0,10,0"/>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,22,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Сохранить" Background="{StaticResource Accent}" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
                <Button Content="Отмена" IsCancel="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="CheckUpdateBtn" Content="Проверить обновления" Padding="10,4" Click="CheckUpdate_Click"/>
                <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
