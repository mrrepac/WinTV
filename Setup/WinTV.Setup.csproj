<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\WinTV\Assets\wintv.ico</ApplicationIcon>
    <AssemblyName>WinTV-Setup</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\publish\payload.zip" LogicalName="payload.zip" Condition="Exists('..\publish\payload.zip')" />
  </ItemGroup>

</Project>
